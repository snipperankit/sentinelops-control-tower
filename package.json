{
  "name": "sentinelops-control-tower",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit tests/policy tests/mcp tests/sandbox",
    "test:policy": "vitest run tests/policy",
    "test:mcp": "vitest run tests/mcp",
    "test:sandbox": "vitest run tests/sandbox",
    "test:e2e": "vitest run tests/e2e",
    "eval:smoke": "tsx evals/runner.ts smoke",
    "eval:core": "tsx evals/runner.ts core",
    "eval:adversarial": "tsx evals/runner.ts adversarial",
    "eval:replay": "tsx evals/runner.ts replay",
    "demo:seed": "tsx harness/demo/seed.ts",
    "demo:reset": "tsx harness/demo/reset.ts",
    "demo:check": "tsx harness/demo/check.ts",
    "health": "tsx harness/healthcheck.ts",
    "mcp:observability": "tsx mcp/observability/index.ts",
    "mcp:deployments": "tsx mcp/deployments/index.ts",
    "mcp:incidents": "tsx mcp/incidents/index.ts",
    "mcp:context": "tsx mcp/context/index.ts",
    "mcp:observability:http": "tsx mcp/observability/http.ts",
    "mcp:deployments:http": "tsx mcp/deployments/http.ts",
    "mcp:incidents:http": "tsx mcp/incidents/http.ts",
    "mcp:context:http": "tsx mcp/context/http.ts",
    "session:server": "tsx harness/server/index.ts",
    "cockpit:install": "npm install --prefix apps/cockpit",
    "cockpit:dev": "npm run dev --prefix apps/cockpit",
    "cockpit:build": "npm run build --prefix apps/cockpit",
    "cockpit:lint": "npm run lint --prefix apps/cockpit",
    "cockpit:typecheck": "npm run typecheck --prefix apps/cockpit",
    "cockpit:test": "npm test --prefix apps/cockpit",
    "cockpit:test:e2e": "npm run test:e2e --prefix apps/cockpit",
    "trueforge": "node scripts/ensure-node-and-run-trueforge.js",
    "test:playwright": "npm run test:e2e --prefix apps/cockpit",
    "live:up": "docker compose --profile live up -d postgres prometheus grafana mailpit",
    "live:down": "docker compose --profile live down",
    "live:logs": "docker compose --profile live logs -f postgres prometheus grafana mailpit",
    "live:bootstrap": "tsx scripts/bootstrap-grafana-token.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.15",
    "@types/pg": "^8.23.1",
    "eslint": "^9.9.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@slack/web-api": "^8.0.0",
    "@truefoundry/trueforge-sdk": "^0.1.3",
    "googleapis": "^176.0.0",
    "nodemailer": "^6.9.14",
    "pg": "^8.11.0",
    "zod": "^3.25.76"
  }
}
